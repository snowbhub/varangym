server {
  listen ${NGINX_PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 5m;

  # One public origin for Passkeys and cookies; all VARANGYM APIs live behind it.
  location ^~ /api/ {
    proxy_pass ${API_BACKEND};
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name ${API_HOST};
    proxy_set_header Host ${API_HOST};
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header Authorization $http_authorization;
    proxy_read_timeout 35s;
  }

  location = /health {
    proxy_pass ${API_BACKEND}/health;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name ${API_HOST};
    proxy_set_header Host ${API_HOST};
  }

  # Old bookmarks must not reopen the retired second management application.
  # Management now lives in role-aware HashRouter routes inside the main VARANGYM shell.
  location = /manage { return 302 /#/home; }
  location = /manage/ { return 302 /#/home; }

  location = /index.html {
    add_header Cache-Control "no-cache, must-revalidate" always;
    try_files $uri =404;
  }

  location ~* \.(?:js|css|json|html)$ {
    add_header Cache-Control "no-cache, must-revalidate" always;
    try_files $uri =404;
  }

  location ~* \.(?:png|jpg|jpeg|gif|ico|svg|woff|woff2|webp|avif)$ {
    expires 30d;
    add_header Cache-Control "public, max-age=2592000, immutable";
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  gzip on;
  gzip_types text/plain text/css application/json application/javascript image/svg+xml;
  gzip_vary on;
}
