server {
  listen ${NGINX_PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Staging uses the platform API's Railway HTTPS domain. Keep the upstream Host/SNI
  # separate from the browser Host or Railway will route the proxied request to the web service.
  location /api/ {
    proxy_pass ${API_BACKEND};
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name ${API_HOST};
    proxy_set_header Host ${API_HOST};
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header Authorization $http_authorization;
    proxy_read_timeout 35s;
  }

  location = /health {
    proxy_pass ${API_BACKEND}/health;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name ${API_HOST};
    proxy_set_header Host ${API_HOST};
  }

  # During staging, always serve the newest dashboard assets after a deploy.
  location = /index.html {
    add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    try_files $uri =404;
  }

  location ~* \.(?:js|css)$ {
    add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
